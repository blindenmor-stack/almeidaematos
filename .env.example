# ============================================================================
# Blog Automatizado A&M — variáveis de ambiente (criar na Vercel e/ou .env local)
# NUNCA commitar valores reais. Este arquivo é só o gabarito.
# ============================================================================

# Supabase (projeto do CRM — schema `aquisicao`)
SUPABASE_URL=https://argvppsbnoeyozjepagb.supabase.co
# Service role key (Settings → API no dashboard do Supabase). NUNCA expor no front.
SUPABASE_SECRET_KEY=

# Google AI Studio (Gemini) — geração dos artigos
GEMINI_API_KEY=

# Senha do painel /admin/ (escolha uma senha forte)
ADMIN_PASSWORD=

# Segredo do Vercel Cron (string aleatória longa — ex: openssl rand -hex 32).
# A Vercel injeta `Authorization: Bearer $CRON_SECRET` nas chamadas de cron.
CRON_SECRET=
